{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finanz-Manager",
  "version": "0.1.0",
  "identifier": "com.fabi.finanzmanager",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Finanz-Manager",
        "width": 1240,
        "height": 820,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Finance",
    "shortDescription": "Finanzen und Abos tracken",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/NetworkHybrid/finanz-manager/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxNzE3QkFFRThBOTdCMkQKUldRdGU2bm9ybnR4a2I2bXIzOXg3d2dNMFpvWmdSdVpjVWtxRk5VQXhRYU05QmJ4ZUU4NnlBT2kK"
    }
  }
}
